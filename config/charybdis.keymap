    //
    //        smart_shift: smart_shift {
    //            compatible = "zmk,behavior-mod-morph";
    //            #binding-cells = <0>;
    //            bindings = <&sk LSHIFT>, <&caps_word>;
    //
    //            mods = <(MOD_LSFT)>;
    //        };
    //    };

    combos {
        compatible = "zmk,combos";
        timeout-ms = <20>;
        require-prior-idle-ms = <250>;

        combo_reset_central {
            key-positions = <23 12>;
            bindings = <&bootloader>;
            require-prior-idle-ms = <2000>;
        };

        combo_unlock {
            key-positions = <0 4>;
            bindings = <&studio_unlock>;
        };

        cmbEn {
            bindings = <&layer_en>;
            key-positions = <16 17>;
            layers = <6>;
        };

        cmbRu {
            bindings = <&layer_ru>;
            key-positions = <16 17>;
            layers = <0>;
        };

        LRPar {
            bindings = <&LR_Par>;
            key-positions = <20 19>;
            layers = <0 2 4>;
        };

        lr_brc {
            bindings = <&LR_brc>;
            key-positions = <31 32>;
            layers = <0 2>;
        };

        en_Lr_Brc {
            bindings = <&enBrct>;
            key-positions = <31 32>;
            layers = <4 5>;
        };

        lr_brs {
            bindings = <&LR_brs>;
            key-positions = <44 43>;
            layers = <0 2>;
        };

        en_lr_Brs {
            bindings = <&en_LR_brs>;
            key-positions = <43 44>;
            layers = <6 5>;
        };

        lr_uDQT {
            bindings = <&LR_ruDKT>;
            key-positions = <18 19>;
            layers = <0 2>;
        };

        lr_enDQT {
            bindings = <&LR_enDKT>;
            key-positions = <18 19>;
            layers = <5 6>;
        };

        R_sh {
            bindings = <&kp RSHIFT>;
            key-positions = <30 31>;
        };

        L_sh {
            bindings = <&kp LSHFT>;
            key-positions = <28 29>;
        };

        u_ent {
            bindings = <&ent_>;
            key-positions = <44 45>;
        };

        pss {
            bindings = <&pss>;
            key-positions = <47 55>;
            layers = <0>;
        };

        hue {
            bindings = <&hueplet>;
            key-positions = <40 41>;
            layers = <0>;
        };
    };

    chosen { zmk,physical-layout = &charybdis_6col_layout; };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LS(LEFT_CONTROL)>, <&macro_wait_time 300>, <&kp N2>;

            label = "TO_RU";
            wait-ms = <20>;
            tap-ms = <60>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LS(LCTRL)>, <&macro_wait_time 300>, <&kp N1>;

            label = "TO_EN";
            wait-ms = <20>;
            tap-ms = <60>;
        };

        to_ru_fast: to_ru_fast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LS(LC(N2))>;
            label = "TO_RU_FAST";
            wait-ms = <20>;
            tap-ms = <60>;
        };

        to_en_fast: to_en_fast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LS(RC(N1))>;
            label = "TO_EN_FAST";
            wait-ms = <20>;
            tap-ms = <60>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en &to 0>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <60>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_ru &to 7>;
            label = "LAYER_RU";
            tap-ms = <60>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en_fast>,
                <&macro_wait_time 5>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru_fast>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        LR_Par: LR_Par {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT_ARROW>;
            label = "LR_PAR";
        };

        LR_brc: LR_brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT_ARROW>;
            label = "LR_BRC";
        };

        enBrct: enBrct {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en_fast &kp LEFT_BRACKET &kp RIGHT_BRACKET &kp LEFT_ARROW &to_ru_fast>;
            label = "ENBRCT";
        };

        LR_brs: LR_brs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW>;
            label = "LR_BRS";
        };

        en_LR_brs: en_LR_brs {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to_en_fast &kp LEFT_BRACE &kp RIGHT_BRACE &kp LEFT_ARROW &to_ru_fast>;
            label = "EN_LR_BRS";
        };

        LR_ruDKT: LR_ruDKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RU_DOUBLE_QUOTES &kp RU_DOUBLE_QUOTES &kp LEFT_ARROW>;
            label = "LR_RUDKT";
        };

        LR_enDKT: LR_enDKT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT_ARROW>;
            label = "LR_ENDKT";
        };

        boot_lo: boot_lo {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bootloader>;
            label = "BOOTL";
        };

        ent_: ent_ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ENTER>;
            label = "ENT_";
        };

        to_Fkeys: to_Fkeys {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&tog 2>;
            label = "TO_FKEYS";
        };

        pss: pss {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(R) &kp I &kp Y &kp N2 &kp N1 &kp N4 &kp LS(B) &kp L &kp A &kp U &kp N6 &kp N2 &kp LS(V) &kp V>;
            label = "PSS";
        };

        hueplet: hueplet {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp L &kp A &kp D &kp I &kp M &kp I &kp R &kp SPACE &kp S &kp H &kp A &kp H &kp I &kp D &kp Z &kp H &kp A &kp N &kp Y &kp A &kp N>;
            label = "HUEPLET";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        En {
            label = "BASE";
            display-name = "En";
            bindings = <
&kp F1    &kp F2  &kp F3  &kp F4  &kp F5     &kp F6           &kp F7    &kp F8      &kp F9  &kp F10  &kp F11  &kp F12
&kp ESC   &kp Q   &kp W   &kp E   &kp R      &kp T            &kp Y     &kp U       &kp I   &kp O    &kp P    &none
&kp TAB   &kp A   &kp S   &kp D   &kp F      &kp G            &kp H     &kp J       &kp K   &kp L    &none    &kp FSLH
&kp LALT  &kp Z   &kp X   &kp C   &kp V      &kp B            &kp N     &kp M       &none   &none    &kp DOT  &kp COMMA
                          &mo 3   &kp LCTRL  &kp SPACE        &kp LWIN  &kp LSHIFT
                                  &mo 2      &kp BACKSPACE    &kp DEL
            >;
        };

        MOUSE {
            label = "MOUSE";
            display-name = "MOUSE";
            bindings = <
&trans  &trans    &trans    &trans     &trans     &trans      &trans  &trans    &trans    &trans    &trans  &trans
&trans  &trans    &trans    &trans     &trans     &trans      &trans  &trans    &trans    &trans    &trans  &trans
&trans  &kp LGUI  &kp LALT  &kp LSHFT  &kp LCTRL  &trans      &trans  &mkp MB1  &mkp MB2  &mkp MB3  &trans  &trans
&trans  &trans    &trans    &mo 3      &mo 2      &trans      &trans  &trans    &trans    &trans    &trans  &trans
                            &mkp MB1   &mkp MB2   &mkp MB3    &trans  &trans
                                       &trans     &trans      &trans
            >;
        };

        Sym_en {
            label = "SYMBOL";
            display-name = "Sym En";
            bindings = <
&trans        &trans     &trans     &trans     &sys_reset  &bootloader    &trans            &trans             &trans          &trans           &trans     &trans
&kp AT        &kp HASH   &kp PRCNT  &kp CARET  &kp AMPS    &none          &kp LT            &kp GT             &kp LPAR        &kp RPAR         &kp PLUS   &kp MINUS
&trans        &kp TILDE  &kp GRAVE  &kp SQT    &kp DQT     &kp DLLR       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE  &kp ASTRK  &kp FSLH
&kp LEFT_ALT  &kp BSLH   &kp PIPE   &kp FSLH   &none       &kp EXCL       &kp QUESTION      &none              &kp UNDER       &kp EQUAL        &kp COLON  &kp SEMICOLON
                                    &trans     &trans      &trans         &trans            &trans
                                               &trans      &trans         &trans
            >;
        };

        Num_arrow {
            label = "NUMBER";
            display-name = "Num arrow";
            bindings = <
&trans    &trans           &trans             &trans    &trans     &trans        &bootloader  &sys_reset     &trans  &trans     &trans      &trans
&none     &kp PAUSE_BREAK  &kp C_VOLUME_UP    &kp UP    &kp PG_UP  &kp HOME      &kp N7       &kp N8         &kp N9  &kp N0     &kp PLUS    &kp MINUS
&none     &kp PRINTSCREEN  &kp LEFT           &kp DOWN  &kp RIGHT  &kp INS       &kp N4       &kp N5         &kp N6  &none      &kp STAR    &kp RU_FSLH
&kp LALT  &none            &kp C_VOLUME_DOWN  &kp C_PP  &kp PG_DN  &kp END       &kp N1       &kp N2         &kp N3  &kp EQUAL  &kp RU_DOT  &kp RU_COMMA
                                              &trans    &trans     &kp LSHIFT    &kp RSHIFT   &kp RIGHT_ALT
                                                        &trans     &trans        &kp RCTRL
            >;
        };

        FUNCTION {
            label = "FUNCTION";
            display-name = "FUNCTION";
            bindings = <
&trans    &trans                   &trans                &trans              &trans              &trans                &trans              &trans                     &trans               &trans                 &trans               &trans
&kp ESC   &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&kp TAB   &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&kp LALT  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I     &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_DOT           &kp RU_COMMA
                                                         &mo 3               &kp LCTRL           &kp SPACE             &kp LWIN            &kp LSHIFT
                                                                             &mo 5               &kp BACKSPACE         &kp DEL
            >;
        };

        Sym_ru {
            label = "GAME";
            display-name = "Sym Ru";
            bindings = <
&trans         &trans            &trans     &trans       &trans      &trans                &trans            &trans                     &trans          &trans           &trans        &trans
&en AT         &en HASH          &kp PRCNT  &en CARET    &en AMPS    &kp RU_CYRILLIC_IO    &en LT            &en GT                     &kp LPAR        &kp RPAR         &kp PLUS      &kp MINUS
&kp RU_NUMERO  &en TILDE         &en GRAVE  &en SQT      &kp RU_DQT  &en DLLR              &en LEFT_BRACKET  &en RIGHT_BRACKET          &en LEFT_BRACE  &en RIGHT_BRACE  &kp STAR      &kp RU_FSLH
&kp LALT       &kp RU_BACKSLASH  &en PIPE   &kp RU_FSLH  &none       &kp EXCL              &kp RU_QUESTION   &kp RU_CYRILLIC_HARD_SIGN  &kp UNDER       &kp EQUAL        &kp RU_COLON  &kp RU_SEMICOLON
                                            &trans       &trans      &trans                &trans            &trans
                                                         &trans      &trans                &trans
            >;
        };

        Reset {
            label = "Reset";
            display-name = "Ru";
            bindings = <
&trans    &trans                   &trans                &trans              &trans              &trans                &trans              &trans                     &trans               &trans                 &trans               &trans
&kp ESC   &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&kp TAB   &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&kp LALT  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I     &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_DOT           &kp RU_COMMA
                                                         &lt 3 A             &kp LCTRL           &kp SPACE             &mo 5               &mo 3
                                                                             &lt 5 A             &kp BACKSPACE         &kp DEL
            >;
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans    &trans                   &trans                &trans              &trans              &trans                &trans              &trans                     &trans               &trans                 &trans               &trans
&kp ESC   &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE   &kp RU_CYRILLIC_HA
&kp TAB   &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE  &kp RU_CYRILLIC_E
&kp LALT  &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I     &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_DOT           &kp RU_COMMA
                                                         &lt 3 A             &kp LCTRL           &kp SPACE             &mo 5               &mo 3
                                                                             &lt 5 A             &kp BACKSPACE         &kp DEL
            >;
        };
    };
};
